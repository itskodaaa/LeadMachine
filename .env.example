# ── Titan mailbox (MonoVM / EU reseller) ──────────────────────────
TITAN_EMAIL=you@yourdomain.com
TITAN_PASSWORD=your-titan-password
SMTP_HOST=smtp0101.titan.email
SMTP_PORT=465
IMAP_HOST=imap0101.titan.email
IMAP_PORT=993

# ── Sender identity (appears in the email footer — MUST be real) ──
SENDER_NAME=Your Name
SENDER_TITLE=Your Title
SENDER_COMPANY=Your Company
SENDER_ADDRESS=Street, City, State ZIP
SENDER_PHONE=+1-555-000-0000
SENDER_WEBSITE=https://yourcompany.com

# ── Offer details (spec + NDA delivery) ───────────────────────────
WETRANSFER_URL=https://we.tl/XXXXXX
NDA_ACCESS_CODE=optional-access-code

# ── LLM (optional — for auto-reply drafting; any OpenAI-compatible) ──
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Safety limits ─────────────────────────────────────────────────
SEND_DELAY_MS=12000
DAILY_CAP=50
